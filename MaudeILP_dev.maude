fmod PARAM is
    sorts Param ConstVariable FreeVariable .
    subsorts ConstVariable FreeVariable < Param .
endfm

view Param from TRIV to PARAM is sort Elt to Param . endv

fmod PARAM-LIST is
    pr LIST{Param} * ( sort NeList{Param} to NeParamList, sort List{Param} to ParamList, op __ to _`,_ ) .
endfm

fmod PRED is sort Pred . endfm
view Pred from TRIV to PRED is sort Elt to Pred . endv
fmod PRED-LIST is pr LIST{Pred} * ( sort NeList{Pred} to NePredList, sort List{Pred} to PredList ) . endfm

fmod LITERAL is
    pr PRED-LIST . pr PARAM-LIST . sort Literal .
    op _`(_`) : Pred ParamList -> Literal .
endfm
view Literal from TRIV to LITERAL is sort Elt to Literal . endv
fmod LITERAL-LIST is pr LIST{Literal} * ( sort NeList{Literal} to NeLiteralList, sort List{Literal} to LiteralList ) . endfm

fmod RULE is
    pr LITERAL-LIST . sorts FOVar SOVar . subsort Pred < SOVar . subsort Param < FOVar .
    sorts Head Body Rule . subsort Literal < Head . subsort LiteralList < Body .
    op _:-_ : Head Body -> Rule [prec 120]. op _:- : Head -> Rule [prec 110].
endfm
view Rule from TRIV to RULE is sort Elt to Rule . endv
fmod RULE-LIST is pr LIST{Rule} * ( sort NeList{Rule} to NeRuleList, sort List{Rule} to RuleList ) . endfm

fmod ILP-DEFINITION-INPUT is
    pr RULE-LIST . pr QID . 
    ops BK POS NEG : -> PredList . op METARULES : -> RuleList .

    --- Global Bypass Flag for Performance
    op USE-ADVANCED-BK : -> Bool . eq USE-ADVANCED-BK = false [owise] .

    --- Sockets for Advanced ILP
    op hasMappedFunc : Qid -> Bool . eq hasMappedFunc(Q:Qid) = false [owise] .
    op mappedFunc : Qid -> Qid . eq mappedFunc(Q:Qid) = 'none [owise] .
    op isIBK : Qid -> Bool . eq isIBK(Q:Qid) = false [owise] .
    op expandIBK : Pred -> PredList . eq expandIBK(P:Pred) = P:Pred [owise] .
    op apply : Param ParamList -> Pred .
endfm

fmod ILP-PROBLEM is 
    pr ILP-DEFINITION-INPUT .
    sort Person . subsort Person < Param .
    ops ann bob cal dawn : -> Person [ctor] .
    ops parent grandparent great-grandparent : Person Person -> Pred [ctor] .
    eq BK = parent(ann, bob) parent(bob, cal) parent(cal, dawn) .
    eq POS = great-grandparent(ann, dawn) .
    eq NEG = grandparent(ann, dawn) .
    vars P Q R : Pred . vars A B C : Person .
    eq METARULES = (P(A,B) :- (Q(A,C)) (R(C,B))) [nonexec] .
endfm

fmod MODULE-HANDLING is
    pr META-LEVEL .
    vars EqS : EquationSet . vars AtS : AttrSet . vars C : Constant . vars T T' : Term . vars M : Module . vars Q : Qid .
    op getEqsOfQid : Module Qid -> EquationSet .
    op getEqsOfQid : EquationSet Qid -> EquationSet .
    eq getEqsOfQid(M, Q) = getEqsOfQid(getEqs(M), Q) .
    ceq getEqsOfQid((eq C = T [AtS] .) EqS, Q) = (eq C = T [AtS] .) if Q == C .
    eq getEqsOfQid(EqS, Q) = none [owise] .
    ops lhsEq rhsEq : Equation -> Term .
    eq lhsEq((eq T = T' [AtS] .)) = T . eq rhsEq((eq T = T' [AtS] .)) = T' .
endfm

fmod TERM-SET is
    pr META-LEVEL . sort TermSet . subsort Term < TermSet .
    op emptyTS : -> TermSet [ctor] .
    op _|_ : TermSet TermSet -> TermSet [ctor assoc comm id: emptyTS format (d n d d)] .
    eq X:Term | X:Term = X:Term .
    op _in_ : Term TermSet -> Bool .
    eq T:Term in (T:Term | TS:TermSet) = true . eq T:Term in TS:TermSet = false [owise] .
    op TermSet : TermList -> TermSet .
    eq TermSet(empty) = emptyTS . eq TermSet((T:Term,TL:TermList)) = T:Term | TermSet(TL:TermList) .
endfm

fmod META-TERM-EXT is
    pr META-TERM . pr TERM-SET . sort BindVal . subsorts Qid Term < BindVal .
    sorts NeVarList VarList . subsorts Variable < NeVarList < NeTermList VarList < TermList .
    op _,_ : VarList VarList -> VarList [ctor ditto] .
    op _,_ : NeVarList VarList -> NeVarList [ctor ditto] .
    op _,_ : VarList NeVarList -> NeVarList [ctor ditto] .
    op sizeTL : TermList -> Nat .
    eq sizeTL(empty) = 0 . eq sizeTL((T:Term, TL:TermList)) = sizeTL(TL:TermList) + 1 .
endfm

fmod META-LITERAL is
    pr META-TERM-EXT . sorts MetaLiteral BoundLiteral GroundLiteral . subsorts MetaLiteral GroundLiteral < BoundLiteral .
    op _<>_ : Qid NeTermList -> BoundLiteral . op _<>_ : Variable NeVarList -> MetaLiteral . op _<>_ : Qid NeGroundTermList -> GroundLiteral .
    vars NeGTL : NeGroundTermList . vars NeTL : NeTermList . vars Q : Qid .
    op getSOVar : BoundLiteral -> Qid . op getSOVar : GroundLiteral -> Qid . op getSOVar : MetaLiteral -> Variable .
    eq getSOVar(Q <> NeTL) = Q .
    op getFOVars : BoundLiteral -> NeTermList . op getFOVars : GroundLiteral -> NeGroundTermList . op getFOVars : MetaLiteral -> NeVarList .
    eq getFOVars(Q <> NeTL) = NeTL .
    op getNumOfAriry : BoundLiteral -> Nat . eq getNumOfAriry(Q <> NeTL) = sizeTL(NeTL) .
    op toGroundTerm : GroundLiteral -> GroundTerm . eq toGroundTerm(Q <> NeGTL) = Q[NeGTL] .
    op toTerm : BoundLiteral -> Term . eq toTerm(Q <> NeTL) = Q[NeTL] .
    op hasSOVarOnly : BoundLiteral -> Bool .
    eq hasSOVarOnly(Q <> NeGTL) = Q :: Variable . eq hasSOVarOnly(Q <> NeTL) = false [owise] .
    op isGroundLiteral : BoundLiteral -> Bool .
    eq isGroundLiteral(Q <> NeGTL) = not (Q :: Variable) . eq isGroundLiteral(Q <> NeTL) = false .
endfm

view BoundLiteral from TRIV to META-LITERAL is sort Elt to BoundLiteral . endv

fmod META-LITERAL-LIST is
    pr LIST{BoundLiteral} * ( sort NeList{BoundLiteral} to NeBoundLiteralList, sort List{BoundLiteral} to BoundLiteralList ) .
    sorts NeMetaLiteralList MetaLiteralList NeGroundLiteralList GroundLiteralList .
    subsorts MetaLiteral < NeMetaLiteralList < NeBoundLiteralList MetaLiteralList < BoundLiteralList .
    subsorts GroundLiteral < NeGroundLiteralList < NeBoundLiteralList GroundLiteralList < BoundLiteralList .
    op __ : MetaLiteralList MetaLiteralList -> MetaLiteralList [ctor ditto] .
    op __ : NeMetaLiteralList MetaLiteralList -> NeMetaLiteralList [ctor ditto] .
    op __ : MetaLiteralList NeMetaLiteralList -> NeMetaLiteralList [ctor ditto] .
    op __ : GroundLiteralList GroundLiteralList -> GroundLiteralList [ctor ditto] .
    op __ : NeGroundLiteralList GroundLiteralList -> NeGroundLiteralList [ctor ditto] .
    op __ : GroundLiteralList NeGroundLiteralList -> NeGroundLiteralList [ctor ditto] .
    op nil : -> MetaLiteralList [ctor] .
endfm

fmod META-RULE is
    pr META-LITERAL-LIST . sorts MetaRule BoundRule . subsort MetaRule < BoundRule .
    op _:-_ : MetaLiteral MetaLiteralList -> MetaRule . op _:-_ : BoundLiteral BoundLiteralList -> BoundRule .
    op getHead : MetaRule -> MetaLiteral . op getHead : BoundRule -> BoundLiteral .
    op getBody : MetaRule -> MetaLiteralList . op getBody : BoundRule -> BoundLiteralList .
    eq getHead(BL:BoundLiteral :- BLL:BoundLiteralList) = BL:BoundLiteral . eq getBody(BL:BoundLiteral :- BLL:BoundLiteralList) = BLL:BoundLiteralList .
endfm

view BoundRule from TRIV to META-RULE is sort Elt to BoundRule . endv

fmod RENAME-VARS is
    pr META-TERM-EXT . pr META-RULE . pr CONVERSION .
    vars V : Variable . vars N : Nat . vars ML : MetaLiteral . vars MLL : MetaLiteralList . vars S S1 S2 : String . vars Pos : Nat .
    op renameVar : Variable Nat -> Variable .
    ceq renameVar(V, N) = qid(S1 + string(N, 10) + ":" + S2) if S := string(V) /\ Pos := find(S, ":", 0) /\ S1 := substr(S, 0, Pos) /\ S2 := substr(S, Pos + 1, length(S)) .
    op renameNeVarList : NeVarList Nat -> NeVarList .
    eq renameNeVarList(V:Variable, N) = renameVar(V:Variable, N) .
    eq renameNeVarList((V:Variable, VL:NeVarList), N) = renameVar(V:Variable, N), renameNeVarList(VL:NeVarList, N) .
    op renameVarsML : MetaLiteral Nat -> MetaLiteral .
    eq renameVarsML(V:Variable <> VL:NeVarList, N) = renameVar(V:Variable, N) <> renameNeVarList(VL:NeVarList, N) .
    op renameVarsMLL : MetaLiteralList Nat -> MetaLiteralList .
    eq renameVarsMLL(nil, N) = nil . eq renameVarsMLL(ML MLL, N) = renameVarsML(ML, N) renameVarsMLL(MLL, N) .
    op renameVarsMR : MetaRule Nat -> MetaRule .
    eq renameVarsMR(ML :- MLL, N) = renameVarsML(ML, N) :- renameVarsMLL(MLL, N) .
endfm

fmod META-RULE-SET is
    pr SET{BoundRule} * ( sort NeSet{BoundRule} to NeBoundRuleSet, sort Set{BoundRule} to BoundRuleSet ) .
    sorts NeMetaRuleSet MetaRuleSet .
    subsorts MetaRule < NeMetaRuleSet < NeBoundRuleSet . subsorts NeMetaRuleSet < MetaRuleSet < BoundRuleSet .
    op _,_ : MetaRuleSet MetaRuleSet -> MetaRuleSet [ctor ditto] .
    op _,_ : MetaRuleSet NeMetaRuleSet -> NeMetaRuleSet [ctor ditto] .
    op _,_ : NeMetaRuleSet MetaRuleSet -> NeMetaRuleSet [ctor ditto] .
    vars BLL : BoundLiteralList . vars BRS : BoundRuleSet . vars NeTL : NeTermList . vars Q : Qid .
    op hasRuleByQid : Qid BoundRuleSet -> Bool .
    eq hasRuleByQid(Q, ((Q <> NeTL :- BLL), BRS)) = true . eq hasRuleByQid(Q, BRS) = false [owise] .
endfm

fmod PARSING is
    pr MODULE-HANDLING . pr META-RULE-SET . pr CONVERSION .
    vars GLit : GroundLiteral . vars NeTL : NeTermList . vars EQ : Equation .
    vars TL : TermList . vars TS : TermSet . vars T T1 T2 T' : Term .
    vars M : Module . vars Q : Qid . vars N : Nat . vars C : Constant .
    op parseItems : Module Qid -> TermSet .
    ceq parseItems(M, Q) = parseItems*(rhsEq(EQ)) if EQ := getEqsOfQid(M, Q) . eq parseItems(M, Q) = emptyTS .
    op parseItems* : Term -> TermSet .
    eq parseItems*('__[T, T']) = T | parseItems*(T') . eq parseItems*(T) = T [owise] .
    op parseRules : Module Qid -> MetaRuleSet .
    ceq parseRules(M, Q) = parseRules*(rhsEq(EQ)) if EQ := getEqsOfQid(M, Q) . eq parseRules(M, Q) = empty [owise] .
    op parseRules* : Term -> MetaRuleSet .
    eq parseRules*('__[T, T']) = parseRule(T), parseRules*(T') . eq parseRules*(T) = parseRule(T) .
    op parseRule : Term -> MetaRuleSet .
    eq parseRule('_:-_[T, T']) = parseLiteral(T) :- parseBody(T') . eq parseRule('_:-[T]) = parseLiteral(T) :- nil . eq parseRule(T) = empty [owise] .
    op parseLiteral : Term -> MetaLiteral .
    eq parseLiteral('_`(_`)[T, T']) = T <> parseParams(T') .
    op parseParams : Term -> TermList .
    eq parseParams('_`,_[T1, T2]) = parseParams(T1) , parseParams(T2) . eq parseParams(T) = T [owise] .
    op parseBody : Term -> MetaLiteralList .
    eq parseBody('__[T, T']) = parseLiteral(T) parseBody(T') . eq parseBody(T) = parseLiteral(T) [owise] .
    op getPred : Term -> Qid . op getArgs : Term -> TermList . op getNumOfArgs : Term -> Nat .
    eq getPred(Q[NeTL]) = Q . eq getArgs(Q[NeTL]) = NeTL . eq getNumOfArgs(Q[NeTL]) = sizeTL(NeTL) .
    eq getPred(C) = getName(C) . eq getArgs(C) = empty . eq getNumOfArgs(C) = 0 .
    op hasElt : GroundLiteral TermSet -> Bool .
    eq hasElt(GLit, TS) = toGroundTerm(GLit) in TS .
    op getPredInvName : Nat -> Qid . eq getPredInvName(N) = qid("inv" + string(N + 1, 10)) .
endfm

fmod ILP-PARSING-INPUT is
    pr PARSING .
    op getBK`(`) : -> TermSet . op getPOS`(`) : -> TermSet . op getNEG`(`) : -> TermSet . op getMetaRules`(`) : -> MetaRuleSet .
    eq getBK() = parseItems(upModule('ILP-PROBLEM, false), 'BK.PredList) .
    eq getPOS() = parseItems(upModule('ILP-PROBLEM, false), 'POS.PredList) .
    eq getNEG() = parseItems(upModule('ILP-PROBLEM, false), 'NEG.PredList) .
    eq getMetaRules() = parseRules(upModule('ILP-PROBLEM, false), 'METARULES.RuleList) .
endfm

view Var from TRIV to META-TERM-EXT is sort Elt to Variable . endv
view BindVal from TRIV to META-TERM-EXT is sort Elt to BindVal . endv

fmod ENV is
    pr MAP{Var,BindVal} * ( sort Entry{Var,BindVal} to Bind, sort Map{Var,BindVal} to Env ) .
    sorts ErrEnv Env&Err . subsort Env ErrEnv < Env&Err .
    op errEnv : -> ErrEnv [ctor] . eq errEnv, (V |-> BV) = errEnv . eq errEnv, errEnv = errEnv .
    vars BV? : [BindVal] . vars BV : BindVal . vars V : Variable . vars ENV : Env .
    op _**<<_ : Qid Env -> BindVal .
    ceq V **<< ENV = (if BV? == undefined then V else BV? fi) if BV? := ENV[V] . eq BV **<< ENV = BV [owise] .
endfm

fmod RULE-AND-ENV is pr META-RULE-SET . pr ENV . sort Rule&Env . op [_,_] : BoundRule Env -> Rule&Env . endfm
view RuleAndEnv from TRIV to RULE-AND-ENV is sort Elt to Rule&Env . endv
fmod PATH is pr LIST{RuleAndEnv} * ( sort NeList{RuleAndEnv} to NePath, sort List{RuleAndEnv} to Path ) . endfm

fmod GOAL is
    pr META-TERM-EXT . pr BOUND . pr PATH . pr META-RULE . pr ENV .
    sorts MetaContext BoundContext .
    op mctx : BoundLiteral BoundLiteralList MetaRule Env Nat -> MetaContext [ctor] .
    op bctx : BoundLiteral BoundLiteralList BoundRule Env Nat -> BoundContext [ctor] .
    sort ContextStack . subsorts MetaContext BoundContext < ContextStack .
    op emptyStack : -> ContextStack [ctor] . op _|_ : ContextStack ContextStack -> ContextStack [ctor assoc id: emptyStack] .
    sort Goal .
    op {goal:_,rules:_,path:_,depth:_,stack:_} : Term BoundRuleSet Path Bound ContextStack -> Goal .
    op {lits:_,facts:_,path:_,depth:_,stack:_} : BoundLiteralList TermSet Path Bound ContextStack -> Goal .
endfm

view Goal from TRIV to GOAL is sort Elt to Goal . endv
fmod GOAL-LIST is pr LIST{Goal} * ( sort NeList{Goal} to NeGoalList, sort List{Goal} to GoalList ) . endfm

fmod ILP-OUTPUT is
    pr PATH . pr ENV .
    vars MLL : BoundLiteralList . vars SOVar : Variable . vars ML : MetaLiteral .
    vars BR : BoundRule . vars MR : MetaRule . vars VL : VarList . vars PATH : Path . vars ENV : Env . vars T' : Term . vars S : Sort .
    op isConstantVar : Term -> Bool .
    ceq isConstantVar(V:Variable) = sortLeq(upModule('ILP-PROBLEM, false), S, 'ConstVariable) if S := getType(V:Variable) . eq isConstantVar(T:Term) = false [owise] .
    op applyConstants : TermList Env -> TermList .
    eq applyConstants(empty, ENV) = empty .
    ceq applyConstants((V:Variable, TL:TermList), ENV) = (if isConstantVar(V:Variable) then T' else V:Variable fi) , applyConstants(TL:TermList, ENV) if T' := (V:Variable **<< ENV) .
    eq applyConstants((T:Term, TL:TermList), ENV) = T:Term , applyConstants(TL:TermList, ENV) [owise] .
    op buildClauseSet : Path -> BoundRuleSet .
    eq buildClauseSet(nil) = empty . eq buildClauseSet([MR, ENV] PATH) = buildClause(MR, ENV), buildClauseSet(PATH) .
    op buildClause : MetaRule Env -> BoundRule .
    eq buildClause(ML :- MLL, ENV) = buildBoundLiteral(ML, ENV) :- buildBoundLiteralList(MLL, ENV) .
    op buildBoundLiteralList : BoundLiteralList Env -> BoundLiteralList .
    eq buildBoundLiteralList(nil, ENV) = nil . eq buildBoundLiteralList(ML MLL, ENV) = buildBoundLiteral(ML, ENV) buildBoundLiteralList(MLL, ENV) .
    op buildBoundLiteral : BoundLiteral Env -> BoundLiteral .
    eq buildBoundLiteral(SOVar <> VL, ENV) = (SOVar **<< ENV) <> applyConstants(VL, ENV) .
    op buildClauseSet2 : Path -> BoundRuleSet .
    eq buildClauseSet2(nil) = empty . eq buildClauseSet2([BR, ENV] PATH) = BR, buildClauseSet2(PATH) .
endfm

fmod ENV-APPLYING is
    pr META-LITERAL . pr ENV .
    vars BV? : [BindVal] . vars TL : TermList . vars V : Variable . vars BV : BindVal . vars ENV : Env . vars T : Term . vars Q : Qid .
    op _<<_ : BoundLiteral Env -> BoundLiteral . eq (Q <> TL) << ENV = (Q **<< ENV) <> (TL *<< ENV) .
    op _*<<_ : TermList Env -> TermList . eq (T, TL) *<< ENV = (T **<< ENV), (TL *<< ENV) . eq (empty *<< ENV) = empty .
    op _**<<_ : Qid Env -> BindVal . ceq V **<< ENV = (if BV? == undefined then V else BV? fi) if BV? := ENV[V] . eq BV **<< ENV = BV [owise] .
endfm

fmod LITERAL-MATCHING is
    pr META-LITERAL . pr PARSING . pr ENV .
    vars BL : BoundLiteral . vars TL TL' : TermList . vars T T' : Term . vars G : Term . vars S : Sort . vars BV? : [BindVal] . vars ENV : Env .
    
    op matchLiteral : Term BoundLiteral -> Env&Err .
    --- STRICT MATCHING: No fake 0-arity matches allowed here anymore!
    ceq matchLiteral(G, BL) = 
        (if getSOVar(BL) :: Variable then getSOVar(BL) |-> getPred(G) else if getSOVar(BL) == getPred(G) then empty else errEnv fi fi),
        matchArgs(getArgs(G), getFOVars(BL))
    if getNumOfArgs(G) == getNumOfAriry(BL) .
    eq matchLiteral(G, BL) = errEnv [owise] .

    op matchArgs : TermList TermList -> Env&Err .
    op matchArgs* : TermList TermList Env -> Env&Err .
    eq matchArgs(TL, TL') = matchArgs*(TL, TL', empty) .
    eq matchArgs*(empty, empty, ENV) = ENV .
    ceq matchArgs*((T, TL), (T', TL'), ENV) = 
        if T' :: Variable then 
            if BV? == undefined then matchArgs*(TL, TL', (ENV, (T' |-> T))) else if BV? == T then matchArgs*(TL, TL', ENV) else errEnv fi fi
        else if T' == T then matchArgs*(TL, TL', ENV) else errEnv fi fi 
    if BV? := ENV[T'] .
    eq matchArgs*(TL, TL', ENV) = errEnv [owise] .
endfm

fmod GOAL-HANDLING is
    pr LITERAL-MATCHING . pr ENV-APPLYING . pr ILP-OUTPUT . pr GOAL-LIST . pr RENAME-VARS . pr CONVERSION . 

    vars POS NEG BK BK' : TermSet . vars MRS MRS' BRS BRS' : BoundRuleSet . vars MLL BLL ExpandedLits : BoundLiteralList .
    vars BL BL' FullyBoundBL : BoundLiteral . vars BRS? : [BoundRuleSet] . vars ML : MetaLiteral . vars SOVar V : Variable .
    vars ENV? ExtractedEnv EvalEnv : Env&Err . vars BR ParentBR SubBR : BoundRule . vars MR RenamedMR ParentMR SubMR : MetaRule .
    vars G Fact T TermBL InputArg OutputArg InputArg1 InputArg2 InputTerm1 InputTerm2 InputTerm ResultTerm IBKResultTerm FuncC : Term . 
    vars GL : GoalList . vars PATH : Path . vars N N' ParentDepth Pos : Nat . vars ENV ParentEnv SubEnv NewEnv : Env . vars STACK : ContextStack . 
    vars TargetFunc Q Q' : Qid . vars ArgsT TLP : TermList . vars S S1 : String . vars C : Constant . vars BV? : [BindVal] . 

    ----------------------------------------------------------
    --- META-HELPERS (Guarded by USE-ADVANCED-BK)
    ----------------------------------------------------------
    op isAdvancedBKEnabled : -> Bool [memo] .
    eq isAdvancedBKEnabled = (getTerm(metaReduce(upModule('ILP-PROBLEM, false), 'USE-ADVANCED-BK.Bool)) == 'true.Bool) .

    op metaTermToQid : Term -> Qid .
    ceq metaTermToQid(C) = qid(S1) if S := string(C) /\ Pos := find(S, ".", 0) /\ S1 := substr(S, 0, Pos) .
    eq metaTermToQid(TermBL) = 'none [owise] .

    op qidToMetaQidTerm : Qid -> Term . eq qidToMetaQidTerm(Q) = qid("'" + string(Q) + ".Qid") .

    op checkHasMappedFunc : Qid -> Bool [memo] .
    ceq checkHasMappedFunc(Q) = (TermBL == 'true.Bool) if TermBL := getTerm(metaReduce(upModule('ILP-PROBLEM, false), 'hasMappedFunc[qidToMetaQidTerm(Q)])) .
    eq checkHasMappedFunc(Q) = false [owise] .

    op getMappedFunc : Qid -> Qid [memo] .
    ceq getMappedFunc(Q) = Q' if TermBL := getTerm(metaReduce(upModule('ILP-PROBLEM, false), 'mappedFunc[qidToMetaQidTerm(Q)])) /\ Q' := metaTermToQid(TermBL) .
    eq getMappedFunc(Q) = 'none [owise] .

    op checkIsIBK : Qid -> Bool [memo] .
    ceq checkIsIBK(Q) = (TermBL == 'true.Bool) if TermBL := getTerm(metaReduce(upModule('ILP-PROBLEM, false), 'isIBK[qidToMetaQidTerm(Q)])) .
    eq checkIsIBK(Q) = false [owise] .

    op qidToTerm : Qid -> Term . eq qidToTerm(Q) = qid(string(Q) + ".Qid") .

    op instantiatePI : TermList Env Nat -> Env .
    eq instantiatePI(empty, ENV, N') = ENV .
    ceq instantiatePI((V, TLP), ENV, N') = instantiatePI(TLP, ENV, N') if ENV[V] :: BindVal .
    ceq instantiatePI((V, TLP), ENV, N') = instantiatePI(TLP, (ENV, (V |-> qidToTerm(getPredInvName(N')))), N' + 1) if not (ENV[V] :: BindVal) .
    eq instantiatePI((TermBL, TLP), ENV, N') = instantiatePI(TLP, ENV, N') [owise] .

    op parseIBKResult : Term -> BoundLiteralList .
    eq parseIBKResult('__[T1:Term, T2:Term]) = parseIBKResult(T1:Term) parseIBKResult(T2:Term) .
    eq parseIBKResult('nil.PredList) = nil .
    ceq parseIBKResult('apply[FuncC, ArgsT]) = TargetFunc <> parseParams(ArgsT) if TargetFunc := metaTermToQid(FuncC) .
    eq parseIBKResult(TargetFunc[ArgsT]) = TargetFunc <> parseParams(ArgsT) [owise] .
    eq parseIBKResult(TermBL) = nil [owise] .

    op isIBKFailed : Term -> Bool .
    eq isIBKFailed('expandIBK[TermBL]) = true . eq isIBKFailed(TermBL) = false [owise] .

    op safeMathReduce : Qid Term -> Term .
    eq safeMathReduce('none, InputTerm) = 'error.Term .
    eq safeMathReduce(TargetFunc, InputTerm) = getTerm(metaReduce(upModule('ILP-PROBLEM, false), TargetFunc[InputTerm])) [owise] .

    op safeMathReduce3 : Qid Term Term -> Term .
    eq safeMathReduce3('none, InputTerm1, InputTerm2) = 'error.Term .
    eq safeMathReduce3(TargetFunc, InputTerm1, InputTerm2) = getTerm(metaReduce(upModule('ILP-PROBLEM, false), TargetFunc[InputTerm1, InputTerm2])) [owise] .

    op safeIBKReduce : Bool Term -> Term .
    eq safeIBKReduce(false, TermBL) = 'error.Term .
    eq safeIBKReduce(true, TermBL) = getTerm(metaReduce(upModule('ILP-PROBLEM, false), 'expandIBK[TermBL])) .

    op isInventedPred : Qid -> Bool .
    eq isInventedPred(Q) = (substr(string(Q), 0, 3) == "inv") .

    op requiresAdvancedBK : Qid -> Bool .
    eq requiresAdvancedBK(Q) = if isAdvancedBKEnabled then checkHasMappedFunc(Q) or checkIsIBK(Q) else false fi .

    ----------------------------------------------------------
    op isCovered : Term BoundRuleSet TermSet Nat -> Bool .
    eq isCovered(G, BRS, BK, N) = if (G in BK) then true else isCoveredByRules(G, BRS, BK, N) fi .
    op isCoveredByRules : Term BoundRuleSet TermSet Nat -> Bool .
    ceq isCoveredByRules(G, BRS, BK, N) = BRS' =/= empty if BRS' := checkGoals({goal: G, rules: BRS, path: nil, depth: 0, stack: emptyStack}, BK, BRS, N) .
    op coverAnyNEG : BoundRuleSet TermSet TermSet Nat -> Bool .
    eq coverAnyNEG(BRS, emptyTS, BK, N) = false .
    eq coverAnyNEG(BRS, G | NEG, BK, N) = if isCovered(G, BRS, BK, N) then true else coverAnyNEG(BRS, NEG, BK, N) fi .
    
    op proceedGoals : GoalList TermSet MetaRuleSet Bound TermSet -> BoundRuleSet .
    eq proceedGoals(nil, BK, MRS', N, NEG) = empty .
    eq proceedGoals({goal: G, rules: empty, path: PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) = proceedGoals(GL, BK, MRS', N, NEG) .
    ceq proceedGoals({goal: G, rules: (MR, MRS), path: PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) = 
        if ENV? == errEnv then proceedGoals({goal: G, rules: MRS, path: PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG)
        else proceedGoals({lits: getBody(RenamedMR), facts: BK, path: [RenamedMR, ENV?] PATH, depth: N', stack: STACK} {goal: G, rules: MRS, path: PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) fi
    if RenamedMR := renameVarsMR(MR, N') /\ ENV? := matchLiteral(G, getHead(RenamedMR)) .
    ceq proceedGoals({lits: nil, facts: BK', path: PATH, depth: N', stack: emptyStack} GL, BK, MRS', N, NEG) = if coverAnyNEG(BRS, NEG, BK, N) then proceedGoals(GL, BK, MRS', N, NEG) else BRS fi if BRS := buildClauseSet(PATH) .
    ceq proceedGoals({lits: nil, facts: BK', path: [SubMR, SubEnv] PATH, depth: N', stack: mctx(BL, MLL, ParentMR, ParentEnv, ParentDepth) | STACK} GL, BK, MRS', N, NEG) =
        if ExtractedEnv == errEnv then proceedGoals(GL, BK, MRS', N, NEG) else proceedGoals({lits: MLL, facts: BK, path: [ParentMR, (ParentEnv, ExtractedEnv)] [SubMR, SubEnv] PATH, depth: ParentDepth, stack: STACK} GL, BK, MRS', N, NEG) fi
    if ExtractedEnv := matchArgs(getArgs(toTerm(BL << SubEnv)), getFOVars(BL)) .
    
    --- [FIX] Ground literals now bypass to proceedGoalsWithFacts IF they are IBK/Math built-ins
    ceq proceedGoals({lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) = 
        if isGroundLiteral(BL) and not requiresAdvancedBK(getSOVar(BL)) then
            if (hasElt(BL, BK)) then proceedGoals({lits: MLL, facts: BK, path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG)
            else if (N' < N) and (isRecursiveCall(MR, ENV, BL) or isInventedPred(getSOVar(BL))) then
                    if (MLL == nil) then proceedGoals(GL {goal: toTerm(BL), rules: MRS', path: [MR, ENV] PATH, depth: (N' + 1), stack: STACK}, BK, MRS', N, NEG)
                    else proceedGoals(GL {goal: toTerm(BL), rules: MRS', path: PATH, depth: (N' + 1), stack: mctx(BL, MLL, MR, ENV, N') | STACK}, BK, MRS', N, NEG) fi
                 else proceedGoals(GL, BK, MRS', N, NEG) fi fi
        else proceedGoalsWithFacts({lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) fi
    if BL := (ML << ENV) .
    
    op isRecursiveCall : MetaRule Env BoundLiteral -> Bool .
    ceq isRecursiveCall(MR, ENV, BL) = getSOVar(BL) == getSOVar(BL') and (BL =/= BL') if BL' := (getHead(MR) << ENV) .
    op proceedGoalsWithFacts : GoalList TermSet MetaRuleSet Bound TermSet -> BoundRuleSet .

    ----------------------------------------------------------
    --- INTERCEPTOR 0: Signature Binding (Binds Q to map/mySucc without consuming the goal)
    ----------------------------------------------------------
    ceq proceedGoalsWithFacts({lits: ML MLL, facts: Fact | BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) =
        proceedGoals(
            {lits: (ML << (ENV, Q |-> TargetFunc)) MLL, facts: BK, path: [MR, (ENV, Q |-> TargetFunc)] PATH, depth: N', stack: STACK}
            {lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG)
    if isAdvancedBKEnabled == true
    /\ BL := (ML << ENV)
    /\ Q := getSOVar(BL)
    /\ Q :: Variable
    /\ getNumOfArgs(Fact) == 0
    /\ TargetFunc := getPred(Fact) .

    ----------------------------------------------------------
    --- INTERCEPTOR 1a: INTENSIONAL BK (ARITY 2)
    ----------------------------------------------------------
    ceq proceedGoalsWithFacts({lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) = 
        if EvalEnv == errEnv then proceedGoals(GL, BK, MRS', N, NEG) else proceedGoals({lits: MLL, facts: BK, path: [MR, EvalEnv] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) fi
    if isAdvancedBKEnabled == true
    /\ BL := (ML << ENV)
    /\ checkHasMappedFunc(getSOVar(BL)) == true
    /\ TargetFunc := getMappedFunc(getSOVar(BL))
    /\ getNumOfAriry(BL) == 2
    /\ (InputArg , OutputArg) := getFOVars(BL) 
    /\ InputTerm := (if InputArg :: Variable then if (InputArg **<< ENV) :: Term then (InputArg **<< ENV) else InputArg fi else InputArg fi)
    /\ not (InputTerm :: Variable) 
    /\ ResultTerm := safeMathReduce(TargetFunc, InputTerm) 
    /\ EvalEnv := (if OutputArg :: Variable then if (OutputArg **<< ENV) == OutputArg then (ENV, (OutputArg |-> ResultTerm)) else if (OutputArg **<< ENV) == ResultTerm then ENV else errEnv fi fi else if OutputArg == ResultTerm then ENV else errEnv fi fi) .

    ----------------------------------------------------------
    --- INTERCEPTOR 1b: INTENSIONAL BK (ARITY 3)
    ----------------------------------------------------------
    ceq proceedGoalsWithFacts({lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) = 
        if EvalEnv == errEnv then proceedGoals(GL, BK, MRS', N, NEG) else proceedGoals({lits: MLL, facts: BK, path: [MR, EvalEnv] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) fi
    if isAdvancedBKEnabled == true
    /\ BL := (ML << ENV)
    /\ checkHasMappedFunc(getSOVar(BL)) == true
    /\ TargetFunc := getMappedFunc(getSOVar(BL))
    /\ getNumOfAriry(BL) == 3
    /\ (InputArg1 , InputArg2 , OutputArg) := getFOVars(BL) 
    /\ InputTerm1 := (if InputArg1 :: Variable then if (InputArg1 **<< ENV) :: Term then (InputArg1 **<< ENV) else InputArg1 fi else InputArg1 fi)
    /\ InputTerm2 := (if InputArg2 :: Variable then if (InputArg2 **<< ENV) :: Term then (InputArg2 **<< ENV) else InputArg2 fi else InputArg2 fi)
    /\ not (InputTerm1 :: Variable) 
    /\ not (InputTerm2 :: Variable) 
    /\ ResultTerm := safeMathReduce3(TargetFunc, InputTerm1, InputTerm2) 
    /\ EvalEnv := (if OutputArg :: Variable then if (OutputArg **<< ENV) == OutputArg then (ENV, (OutputArg |-> ResultTerm)) else if (OutputArg **<< ENV) == ResultTerm then ENV else errEnv fi fi else if OutputArg == ResultTerm then ENV else errEnv fi fi) .

    ----------------------------------------------------------
    --- INTERCEPTOR 2: INTERPRETED BK (IBK)
    ----------------------------------------------------------
    ceq proceedGoalsWithFacts({lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) =
        proceedGoals({lits: ExpandedLits MLL, facts: BK, path: [MR, NewEnv] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG)
    if isAdvancedBKEnabled == true
    /\ BL := (ML << ENV)
    /\ checkIsIBK(getSOVar(BL)) == true
    /\ NewEnv := instantiatePI(getFOVars(BL), ENV, N')
    /\ FullyBoundBL := (ML << NewEnv)
    /\ TermBL := toTerm(FullyBoundBL)
    /\ IBKResultTerm := safeIBKReduce(true, TermBL) 
    /\ isIBKFailed(IBKResultTerm) == false
    /\ ExpandedLits := parseIBKResult(IBKResultTerm) .

    ----------------------------------------------------------
    --- ORIGINAL LOGIC FALLTHROUGH
    ----------------------------------------------------------
    ceq proceedGoalsWithFacts({lits: ML MLL, facts: emptyTS, path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) = 
        if (N' < N) and (size(getBody(MR)) > 1) then
            if (MLL == nil) and hasSOVarOnly(BL) then proceedGoals({goal: toTerm(BL << (getSOVar(BL) |-> getPredInvName(N'))), rules: MRS', path: [MR, (ENV, getSOVar(BL) |-> getPredInvName(N'))] PATH, depth: (N' + 1), stack: STACK} GL, BK, MRS', N, NEG)
            else proceedGoals(GL {goal: toTerm(BL << (getSOVar(BL) |-> getPredInvName(N'))), rules: MRS', path: PATH, depth: (N' + 1), stack: mctx(BL, MLL, MR, (ENV, getSOVar(BL) |-> getPredInvName(N')), N') | STACK}, BK, MRS', N, NEG) fi
        else proceedGoals(GL, BK, MRS', N, NEG) fi 
    if BL := (ML << ENV) .
    ceq proceedGoalsWithFacts({lits: ML MLL, facts: Fact | BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) = 
        if ENV? == errEnv then proceedGoalsWithFacts({lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG)
        else proceedGoals({lits: MLL, facts: BK, path: [MR, (ENV, ENV?)] PATH, depth: N', stack: STACK} {lits: ML MLL, facts: BK', path: [MR, ENV] PATH, depth: N', stack: STACK} GL, BK, MRS', N, NEG) fi
    if BL := (ML << ENV) /\ ENV? := matchLiteral(Fact, BL) .

    op checkGoals : GoalList TermSet BoundRuleSet Bound -> BoundRuleSet .
    eq checkGoals(nil, BK, BRS', N) = empty .
    eq checkGoals({goal: G, rules: empty, path: PATH, depth: N', stack: STACK} GL, BK, BRS', N) = checkGoals(GL, BK, BRS', N) .
    ceq checkGoals({goal: G, rules: (BR, BRS), path: PATH, depth: N', stack: STACK} GL, BK, BRS', N) = 
        if ENV? == errEnv then checkGoals({goal: G, rules: BRS, path: PATH, depth: N', stack: STACK} GL, BK, BRS', N) 
        else checkGoals({lits: getBody(BR), facts: BK, path: [BR, ENV?] PATH, depth: N', stack: STACK} {goal: G, rules: BRS, path: PATH, depth: N', stack: STACK} GL, BK, BRS', N) fi
    if ENV? := matchLiteral(G, getHead(BR)) .
    eq checkGoals({lits: nil, facts: BK', path: PATH, depth: N', stack: emptyStack} GL, BK, BRS', N) = buildClauseSet2(PATH) .
    ceq checkGoals({lits: nil, facts: BK', path: [SubBR, SubEnv] PATH, depth: N', stack: bctx(BL, BLL, ParentBR, ParentEnv, ParentDepth) | STACK} GL, BK, BRS', N) =
        if ExtractedEnv == errEnv then checkGoals(GL, BK, BRS', N) else checkGoals({lits: BLL, facts: BK, path: [ParentBR, (ParentEnv, ExtractedEnv)] [SubBR, SubEnv] PATH, depth: ParentDepth, stack: STACK} GL, BK, BRS', N) fi
    if ExtractedEnv := matchArgs(getArgs(toTerm(BL << SubEnv)), getFOVars(BL)) .
    
    --- [FIX] Ground literals now bypass to checkGoalsWithFacts IF they are IBK/Math built-ins
    ceq checkGoals({lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) = 
        if isGroundLiteral(BL') and not requiresAdvancedBK(getSOVar(BL')) then
            if (hasElt(BL', BK)) then checkGoals({lits: BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N)
            else if (N' < N) and hasRuleByQid(getSOVar(BL'), BRS') then
                    if (BLL == nil) then checkGoals(GL {goal: toTerm(BL'), rules: BRS', path: [BR, ENV] PATH, depth: (N' + 1), stack: STACK}, BK, BRS', N)
                    else checkGoals(GL {goal: toTerm(BL'), rules: BRS', path: PATH, depth: (N' + 1), stack: bctx(BL', BLL, BR, ENV, N') | STACK}, BK, BRS', N) fi
                 else checkGoals(GL, BK, BRS', N) fi fi
        else checkGoalsWithFacts({lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) fi
    if BL' := (BL << ENV) .
    
    op checkGoalsWithFacts : GoalList TermSet BoundRuleSet Bound -> BoundRuleSet .

    ----------------------------------------------------------
    --- INTERCEPTOR 0 for checkGoals: Signature Binding
    ----------------------------------------------------------
    ceq checkGoalsWithFacts({lits: BL BLL, facts: Fact | BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) =
        checkGoals(
            {lits: (BL' << (ENV, Q |-> TargetFunc)) BLL, facts: BK, path: [BR, (ENV, Q |-> TargetFunc)] PATH, depth: N', stack: STACK}
            {lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N)
    if isAdvancedBKEnabled == true
    /\ BL' := (BL << ENV)
    /\ Q := getSOVar(BL')
    /\ Q :: Variable
    /\ getNumOfArgs(Fact) == 0
    /\ TargetFunc := getPred(Fact) .

    ----------------------------------------------------------
    --- INTERCEPTOR 1a for checkGoals: INTENSIONAL BK
    ----------------------------------------------------------
    ceq checkGoalsWithFacts({lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) = 
        if EvalEnv == errEnv then checkGoals(GL, BK, BRS', N) else checkGoals({lits: BLL, facts: BK, path: [BR, EvalEnv] PATH, depth: N', stack: STACK} GL, BK, BRS', N) fi
    if isAdvancedBKEnabled == true
    /\ BL' := (BL << ENV)
    /\ checkHasMappedFunc(getSOVar(BL')) == true
    /\ TargetFunc := getMappedFunc(getSOVar(BL'))
    /\ getNumOfAriry(BL') == 2
    /\ (InputArg , OutputArg) := getFOVars(BL') 
    /\ InputTerm := (if InputArg :: Variable then if (InputArg **<< ENV) :: Term then (InputArg **<< ENV) else InputArg fi else InputArg fi)
    /\ not (InputTerm :: Variable) 
    /\ ResultTerm := safeMathReduce(TargetFunc, InputTerm) 
    /\ EvalEnv := (if OutputArg :: Variable then if (OutputArg **<< ENV) == OutputArg then (ENV, (OutputArg |-> ResultTerm)) else if (OutputArg **<< ENV) == ResultTerm then ENV else errEnv fi fi else if OutputArg == ResultTerm then ENV else errEnv fi fi) .

    ----------------------------------------------------------
    --- INTERCEPTOR 1b for checkGoals: INTENSIONAL BK (ARITY 3)
    ----------------------------------------------------------
    ceq checkGoalsWithFacts({lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) = 
        if EvalEnv == errEnv then checkGoals(GL, BK, BRS', N) else checkGoals({lits: BLL, facts: BK, path: [BR, EvalEnv] PATH, depth: N', stack: STACK} GL, BK, BRS', N) fi
    if isAdvancedBKEnabled == true
    /\ BL' := (BL << ENV)
    /\ checkHasMappedFunc(getSOVar(BL')) == true
    /\ TargetFunc := getMappedFunc(getSOVar(BL'))
    /\ getNumOfAriry(BL') == 3
    /\ (InputArg1 , InputArg2 , OutputArg) := getFOVars(BL') 
    /\ InputTerm1 := (if InputArg1 :: Variable then if (InputArg1 **<< ENV) :: Term then (InputArg1 **<< ENV) else InputArg1 fi else InputArg1 fi)
    /\ InputTerm2 := (if InputArg2 :: Variable then if (InputArg2 **<< ENV) :: Term then (InputArg2 **<< ENV) else InputArg2 fi else InputArg2 fi)
    /\ not (InputTerm1 :: Variable) 
    /\ not (InputTerm2 :: Variable) 
    /\ ResultTerm := safeMathReduce3(TargetFunc, InputTerm1, InputTerm2) 
    /\ EvalEnv := (if OutputArg :: Variable then if (OutputArg **<< ENV) == OutputArg then (ENV, (OutputArg |-> ResultTerm)) else if (OutputArg **<< ENV) == ResultTerm then ENV else errEnv fi fi else if OutputArg == ResultTerm then ENV else errEnv fi fi) .

    ----------------------------------------------------------
    --- INTERCEPTOR 2 for checkGoals: IBK Expansion
    ----------------------------------------------------------
    ceq checkGoalsWithFacts({lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) =
        checkGoals({lits: ExpandedLits BLL, facts: BK, path: [BR, NewEnv] PATH, depth: N', stack: STACK} GL, BK, BRS', N)
    if isAdvancedBKEnabled == true
    /\ BL' := (BL << ENV)
    /\ checkIsIBK(getSOVar(BL')) == true
    /\ NewEnv := instantiatePI(getFOVars(BL'), ENV, N')
    /\ FullyBoundBL := (BL' << NewEnv)
    /\ TermBL := toTerm(FullyBoundBL)
    /\ IBKResultTerm := safeIBKReduce(true, TermBL) 
    /\ isIBKFailed(IBKResultTerm) == false
    /\ ExpandedLits := parseIBKResult(IBKResultTerm) .

    ----------------------------------------------------------
    ceq checkGoalsWithFacts({lits: BL BLL, facts: emptyTS, path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) = 
        if (N' < N) and hasRuleByQid(getSOVar(BL'), BRS') then
            if (BLL == nil) then checkGoals(GL {goal: toTerm(BL'), rules: BRS', path: [BR, ENV] PATH, depth: (N' + 1), stack: STACK}, BK, BRS', N)
            else checkGoals(GL {goal: toTerm(BL'), rules: BRS', path: PATH, depth: (N' + 1), stack: bctx(BL', BLL, BR, ENV, N') | STACK}, BK, BRS', N) fi
        else checkGoals(GL, BK, BRS', N) fi
    if BL' := (BL << ENV) .
    ceq checkGoalsWithFacts({lits: BL BLL, facts: Fact | BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) = 
        if ENV? == errEnv then checkGoalsWithFacts({lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N)
        else checkGoals({lits: BLL, facts: BK, path: [BR, (ENV, ENV?)] PATH, depth: N', stack: STACK} {lits: BL BLL, facts: BK', path: [BR, ENV] PATH, depth: N', stack: STACK} GL, BK, BRS', N) fi
    if BL' := (BL << ENV) /\ ENV? := matchLiteral(Fact, BL') .
endfm

fmod MAUDE-ILP is
    pr ILP-PARSING-INPUT . pr GOAL-HANDLING . pr ILP-OUTPUT .
    vars MRS MRS' : MetaRuleSet . vars POS NEG BK : TermSet . vars BRS BRS' : BoundRuleSet . vars G : Term . vars N : Nat .
    op learn`(`) : -> BoundRuleSet . eq learn() = learn(0) .
    op learn : Bound -> BoundRuleSet . eq learn(N) = learn(getPOS(), getNEG(), getMetaRules(), getBK(), N, empty) .
    op learn : TermSet TermSet MetaRuleSet TermSet Bound BoundRuleSet -> BoundRuleSet .
    eq learn(emptyTS, NEG, MRS, BK, N, BRS') = BRS' .
    eq learn(G | POS, NEG, MRS, BK, N, BRS') = if isCovered(G, BRS', BK, N) then learn(POS, NEG, MRS, BK, N, BRS') else learn*(G | POS, NEG, MRS, BK, N, BRS') fi .
    op learn* : TermSet TermSet MetaRuleSet TermSet Bound BoundRuleSet -> BoundRuleSet .
    ceq learn*(G | POS, NEG, MRS, BK, N, BRS') = if BRS == empty then empty else learn(POS, NEG, MRS, BK, N, (BRS, BRS')) fi
    if BRS := proceedGoals({goal: G, rules: MRS, path: nil, depth: 0, stack: emptyStack}, BK, MRS, N, NEG) .
endfm