load ../MaudeILP.maude .

fmod ILP-PROBLEM is
    pr ILP-DEFINITION-INPUT .

    sorts State Piece NumVal .
    subsorts State Piece NumVal < Param .

    --- Constants for States
    ops st0 st1 st10 st11 st12 st13 st14 st15 st16 st17 st18 st19 : -> State [ctor] .
    ops st2 st20 st21 st22 st23 st24 st25 st26 st27 st28 st29 st3 : -> State [ctor] .
    ops st30 st31 st32 st33 st34 st35 st36 st37 st38 st39 st4 st5 : -> State [ctor] .
    ops st6 st7 st8 st9 : -> State [ctor] .

    --- Constants for Pieces
    ops p0x0 p0x1 p0x2 p10x0 p10x1 p10x2 p10x3 p10x4 p11x0 p11x1 : -> Piece [ctor] .
    ops p11x2 p11x3 p11x4 p12x0 p12x1 p13x0 p13x1 p14x0 p14x1 p14x2 : -> Piece [ctor] .
    ops p14x3 p15x0 p15x1 p15x2 p15x3 p16x0 p16x1 p17x0 p17x1 p18x0 : -> Piece [ctor] .
    ops p18x1 p18x2 p18x3 p19x0 p19x1 p19x2 p1x0 p1x1 p1x2 p1x3 : -> Piece [ctor] .
    ops p1x4 p20x0 p20x1 p20x2 p21x0 p21x1 p21x2 p22x0 p22x1 p22x2 : -> Piece [ctor] .
    ops p22x3 p22x4 p23x0 p23x1 p24x0 p24x1 p24x2 p25x0 p25x1 p25x2 : -> Piece [ctor] .
    ops p26x0 p26x1 p26x2 p26x3 p27x0 p27x1 p27x2 p28x0 p28x1 p28x2 : -> Piece [ctor] .
    ops p28x3 p28x4 p29x0 p29x1 p29x2 p29x3 p2x0 p2x1 p2x2 p2x3 : -> Piece [ctor] .
    ops p2x4 p30x0 p30x1 p30x2 p30x3 p30x4 p31x0 p31x1 p31x2 p31x3 : -> Piece [ctor] .
    ops p32x0 p33x0 p33x1 p33x2 p34x0 p34x1 p34x2 p34x3 p35x0 p35x1 : -> Piece [ctor] .
    ops p36x0 p36x1 p36x2 p36x3 p37x0 p37x1 p38x0 p38x1 p39x0 p39x1 : -> Piece [ctor] .
    ops p39x2 p3x0 p3x1 p3x2 p3x3 p3x4 p4x0 p4x1 p4x2 p5x0 : -> Piece [ctor] .
    ops p5x1 p5x2 p5x3 p6x0 p6x1 p7x0 p7x1 p7x2 p7x3 p7x4 : -> Piece [ctor] .
    ops p8x0 p8x1 p8x2 p8x3 p8x4 p9x0 p9x1 p9x2 p9x3 : -> Piece [ctor] .

    --- Constants for Numbers
    ops n0 n1 n10 n11 n2 n3 n4 n5 n6 n7 n8 n9 : -> NumVal [ctor] .
    ops nm1 : -> NumVal [ctor] .

    --- Predicate Declarations
    op zendo : State -> Pred [ctor] .
    op piece : State Piece -> Pred [ctor] .
    op contact : Piece Piece -> Pred [ctor] .
    op coord1 : Piece NumVal -> Pred [ctor] .
    op coord2 : Piece NumVal -> Pred [ctor] .
    op size : Piece NumVal -> Pred [ctor] .
    op blue : Piece -> Pred [ctor] .
    op green : Piece -> Pred [ctor] .
    op red : Piece -> Pred [ctor] .
    op small : NumVal -> Pred [ctor] .
    op medium : NumVal -> Pred [ctor] .
    op large : NumVal -> Pred [ctor] .
    op upright : Piece -> Pred [ctor] .
    op lhs : Piece -> Pred [ctor] .
    op rhs : Piece -> Pred [ctor] .
    op strange : Piece -> Pred [ctor] .

